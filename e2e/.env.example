# Local settings for the E2E run. Copy to e2e/.env (not committed) and adjust.
# Every value is optional: the defaults suit the usual layout of the two repos.

# Python with the backend's packages installed. Default: <backend>/.venv or
# <backend>/venv if present, otherwise "python" from PATH.
# E2E_PYTHON=C:\path\to\venv\Scripts\python.exe

# Backend folder. Default: ../b2b_backend, then ../backend.
# E2E_BACKEND_DIR=../b2b_backend

# E2E database. Default: DATABASE_URL from the backend .env with "_e2e" added
# to the database name. The name must end with _e2e: it is wiped on every run.
# E2E_DATABASE_URL=postgresql://user:password@localhost:5433/brandmarket_e2e

# Ports of the E2E API and site. Defaults: 8100 and 4100.
# E2E_API_PORT=8100
# E2E_FRONT_PORT=4100

# 1 = keep the E2E database between runs (faster; data from earlier runs stays).
# E2E_KEEP_DB=1

# 1 = serve the last build of the site instead of building again.
# E2E_SKIP_BUILD=1

# Browser. Default on Windows: msedge (installed Edge, no download).
# Elsewhere: Playwright's Chromium, installed once with `npx playwright install chromium`.
# E2E_BROWSER_CHANNEL=chrome
